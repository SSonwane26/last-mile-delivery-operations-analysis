        "    (impact_df[\"orders\"] >= volume_cutoff) & (impact_df[\"delay_rate_percent\"] < delay_cutoff),\n",
        "    (impact_df[\"orders\"] < volume_cutoff) & (impact_df[\"delay_rate_percent\"] >= delay_cutoff),\n",
        "    (impact_df[\"orders\"] < volume_cutoff) & (impact_df[\"delay_rate_percent\"] < delay_cutoff)\n",
        "]\n",
        "labels = [\"High Volume - High Delay\", \"High Volume - Low Delay\", \"Low Volume - High Delay\", \"Low Volume - Low Delay\"]\n",
        "impact_df[\"priority_group\"] = np.select(conditions, labels, default=\"Check\")\n",
        "impact_df[[\"store_primary_category\", \"orders\", \"delayed_orders\", \"delay_rate_percent\", \"delay_contribution_percent\", \"priority_group\"]].head(20)"
      ]
