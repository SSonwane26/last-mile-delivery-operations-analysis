      "source": [
        "df[\"created_at\"] = pd.to_datetime(df[\"created_at\"], errors=\"coerce\")\n",
        "df[\"actual_delivery_time\"] = pd.to_datetime(df[\"actual_delivery_time\"], errors=\"coerce\")\n",
        "\n",
        "df[\"delivery_duration_min\"] = (df[\"actual_delivery_time\"] - df[\"created_at\"]).dt.total_seconds() / 60\n",
        "df[\"order_date\"] = df[\"created_at\"].dt.date\n",
        "df[\"order_hour\"] = df[\"created_at\"].dt.hour\n",
        "df[\"day_name\"] = df[\"created_at\"].dt.day_name()\n",
        "df[\"is_weekend\"] = df[\"day_name\"].isin([\"Saturday\", \"Sunday\"])\n",
        "\n",
        "def get_time_period(hour):\n",
        "    if pd.isna(hour): return \"Unknown\"\n",
        "    if 0 <= hour <= 4: return \"Late Night\"\n",
        "    if 5 <= hour <= 10: return \"Morning\"\n",
        "    if 11 <= hour <= 15: return \"Afternoon\"\n",
        "    if 16 <= hour <= 20: return \"Evening\"\n",
        "    return \"Night\"\n",
        "\n",
        "df[\"time_period\"] = df[\"order_hour\"].apply(get_time_period)\n",
        "df[[\"created_at\", \"actual_delivery_time\", \"delivery_duration_min\", \"order_hour\", \"day_name\", \"time_period\"]].head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "metadata": {},
      "outputs": [],
      "source": [
        "df[\"store_primary_category\"] = df[\"store_primary_category\"].fillna(\"Unknown\")\n",
        "df[\"market_id\"] = df[\"market_id\"].fillna(\"Unknown\").astype(str).str.replace(\".0\", \"\", regex=False)\n",
        "df[\"order_protocol\"] = df[\"order_protocol\"].fillna(\"Unknown\").astype(str).str.replace(\".0\", \"\", regex=False)\n",
        "\n",
        "partner_cols = [\"total_onshift_partners\", \"total_busy_partners\", \"total_outstanding_orders\"]\n",
        "for col in partner_cols:\n",
        "    df[f\"{col}_missing\"] = df[col].isna()\n",
        "    df.loc[df[col] < 0, col] = np.nan\n",
        "    df[col] = df[col].fillna(df[col].median())\n",
        "\n",
        "df[\"available_partners\"] = df[\"total_onshift_partners\"] - df[\"total_busy_partners\"]\n",
        "df.loc[df[\"available_partners\"] < 0, \"available_partners\"] = 0\n",
        "df[\"partner_utilization\"] = df[\"total_busy_partners\"] / df[\"total_onshift_partners\"].replace(0, np.nan)\n",
        "df[\"available_partner_ratio\"] = df[\"available_partners\"] / df[\"total_onshift_partners\"].replace(0, np.nan)\n",
        "df[\"outstanding_orders_per_partner\"] = df[\"total_outstanding_orders\"] / df[\"total_onshift_partners\"].replace(0, np.nan)\n",
        "ratio_cols = [\"partner_utilization\", \"available_partner_ratio\", \"outstanding_orders_per_partner\"]\n",
        "df[ratio_cols] = df[ratio_cols].replace([np.inf, -np.inf], np.nan).fillna(0)\n",
        "df[\"partner_utilization_capped\"] = df[\"partner_utilization\"].clip(0, 1.5)"
      ]
    },
