      "source": [
        "def delay_contribution(data, group_col):\n",
        "    result = data.groupby(group_col).agg(\n",
        "        orders=(\"created_at\", \"count\"),\n",
        "        delayed_orders=(\"sla_45_breach\", \"sum\"),\n",
        "        avg_delivery_min=(\"delivery_duration_min\", \"mean\"),\n",
        "        p90_delivery_min=(\"delivery_duration_min\", lambda x: x.quantile(.90))\n",
        "    ).reset_index()\n",
        "    result[\"delay_rate_percent\"] = (result[\"delayed_orders\"] / result[\"orders\"] * 100).round(2)\n",
        "    result[\"delay_contribution_percent\"] = (result[\"delayed_orders\"] / result[\"delayed_orders\"].sum() * 100).round(2)\n",
        "    result[[\"avg_delivery_min\", \"p90_delivery_min\"]] = result[[\"avg_delivery_min\", \"p90_delivery_min\"]].round(2)\n",
        "    return result.sort_values(\"delayed_orders\", ascending=False)\n",
        "\n",
        "time_delay_contribution = delay_contribution(analysis_df, \"time_period\")\n",
        "market_delay_contribution = delay_contribution(analysis_df, \"market_id\")\n",
        "protocol_delay_contribution = delay_contribution(analysis_df, \"order_protocol\")\n",
        "category_delay_contribution = delay_contribution(analysis_df, \"store_primary_category\")\n",
        "category_delay_contribution = category_delay_contribution[category_delay_contribution[\"orders\"] >= 500]\n",
        "time_delay_contribution"
      ]
    },
