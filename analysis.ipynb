      "source": [
        "## 10. Segment Summary Helper"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "metadata": {},
      "outputs": [],
      "source": [
        "def create_segment_summary(data, group_col):\n",
        "    summary = data.groupby(group_col).agg(\n",
        "        orders=(\"created_at\", \"count\"),\n",
        "        avg_delivery_min=(\"delivery_duration_min\", \"mean\"),\n",
        "        median_delivery_min=(\"delivery_duration_min\", \"median\"),\n",
        "        p90_delivery_min=(\"delivery_duration_min\", lambda x: x.quantile(.90)),\n",
        "        sla_45_breach_rate=(\"sla_45_breach\", \"mean\"),\n",
        "        sla_60_breach_rate=(\"sla_60_breach\", \"mean\"),\n",
        "        avg_partner_utilization=(\"partner_utilization\", \"mean\"),\n",
        "        avg_outstanding_orders=(\"total_outstanding_orders\", \"mean\")\n",
        "    ).reset_index()\n",
        "    summary[\"sla_45_breach_rate\"] = (summary[\"sla_45_breach_rate\"] * 100).round(2)\n",
        "    summary[\"sla_60_breach_rate\"] = (summary[\"sla_60_breach_rate\"] * 100).round(2)\n",
        "    num_cols = [\"avg_delivery_min\", \"median_delivery_min\", \"p90_delivery_min\", \"avg_partner_utilization\", \"avg_outstanding_orders\"]\n",
        "    summary[num_cols] = summary[num_cols].round(2)\n",
        "    return summary"
      ]
    },
