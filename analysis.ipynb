        "root_cause_time = analysis_df.groupby(\"time_period\").agg(\n",
        "    orders=(\"created_at\", \"count\"),\n",
        "    avg_delivery_min=(\"delivery_duration_min\", \"mean\"),\n",
        "    p90_delivery_min=(\"delivery_duration_min\", lambda x: x.quantile(.90)),\n",
        "    sla_45_breach_rate=(\"sla_45_breach\", \"mean\"),\n",
        "    avg_partner_utilization=(\"partner_utilization\", \"mean\"),\n",
        "    avg_available_partner_ratio=(\"available_partner_ratio\", \"mean\"),\n",
        "    avg_outstanding_orders=(\"total_outstanding_orders\", \"mean\"),\n",
        "    avg_items=(\"total_items\", \"mean\"),\n",
        "    avg_subtotal=(\"subtotal\", \"mean\")\n",
        ").reset_index()\n",
        "root_cause_time[\"sla_45_breach_rate\"] = root_cause_time[\"sla_45_breach_rate\"] * 100\n",
        "root_cause_time.round(2).sort_values(\"sla_45_breach_rate\", ascending=False)"
      ]
    },
